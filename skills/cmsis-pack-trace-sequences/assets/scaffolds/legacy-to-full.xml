<cmsis-pack-trace-scaffold use-case="legacy-to-full">
  <!-- Move verified legacy device-specific code into ADD-DEVICE-SPECIFIC markers. Replace legacy debugger-assumed CoreSight configuration with selected component calls. -->
  <sequences traceSetup="full">
    <sequence name="TraceStart">
      <block>
        __var swoTrace = __traceout &amp; 0x1;
        __var syncTrace = __traceout &amp; 0x2;
        __var bufferTrace = __traceout &amp; 0x4;
      </block>
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE BEGIN -->
      <!-- Add migrated device-specific setup here. -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE END -->
      <!-- CMSIS-PACK-TRACE: CORESIGHT-START BEGIN -->
      <!-- Add selected CoreSight Configure calls guarded by these variables. -->
      <!-- CMSIS-PACK-TRACE: CORESIGHT-START END -->
    </sequence>
    <sequence name="TraceCapture">
      <block>
        __var swoTrace = __traceout &amp; 0x1;
        __var syncTrace = __traceout &amp; 0x2;
        __var bufferTrace = __traceout &amp; 0x4;
      </block>
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE BEGIN -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE END -->
      <!-- CMSIS-PACK-TRACE: CORESIGHT-CAPTURE BEGIN -->
      <!-- Add selected CoreSight Capture calls. -->
      <!-- CMSIS-PACK-TRACE: CORESIGHT-CAPTURE END -->
    </sequence>
    <sequence name="DoTraceFlush">
      <block>
        __var swoTrace = __traceout &amp; 0x1;
        __var syncTrace = __traceout &amp; 0x2;
        __var bufferTrace = __traceout &amp; 0x4;
      </block>
      <!-- Add only actual selected CoreSight Flush calls. Do not read a trace buffer here. -->
    </sequence>
    <sequence name="TraceFlush">
      <block>
        __var swoTrace = __traceout &amp; 0x1;
        __var syncTrace = __traceout &amp; 0x2;
        __var bufferTrace = __traceout &amp; 0x4;
      </block>
      <!-- CMSIS-PACK-TRACE: CORESIGHT-FLUSH BEGIN -->
      <block>
        Sequence("DoTraceFlush");
      </block>
      <!-- Add optional CoreSight read-buffer calls after the flush. -->
      <!-- CMSIS-PACK-TRACE: CORESIGHT-FLUSH END -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE BEGIN -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE END -->
    </sequence>
    <sequence name="TraceStop">
      <block>
        __var swoTrace = __traceout &amp; 0x1;
        __var syncTrace = __traceout &amp; 0x2;
        __var bufferTrace = __traceout &amp; 0x4;
      </block>
      <!-- CMSIS-PACK-TRACE: CORESIGHT-STOP BEGIN -->
      <block>
        Sequence("DoTraceFlush");
      </block>
      <!-- CMSIS-PACK-TRACE: CORESIGHT-STOP END -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE BEGIN -->
      <!-- CMSIS-PACK-TRACE: ADD-DEVICE-SPECIFIC-HERE END -->
    </sequence>
  </sequences>
</cmsis-pack-trace-scaffold>



